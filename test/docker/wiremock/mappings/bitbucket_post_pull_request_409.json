{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPattern": "/rest/api/1.0/projects/VSB/repos/vsb-test/pull-requests",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.fromRef.id =~ /.*VSB-409.*/)]"
      }
    ]
  },
  "response": {
    "status": 409,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "errors": [
        {
          "context": null,
          "message": "A pull request for this branch already exists.",
          "exceptionName": "com.atlassian.bitbucket.pull.DuplicatePullRequestException"
        }
      ]
    }
  }
}
